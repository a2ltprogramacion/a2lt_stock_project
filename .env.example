# A2LT Stock — plantilla de variables de entorno.
# Copiar a .env y rellenar. NUNCA commitear el .env real.
#
# Generar SECRET_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

# Produccion: SIEMPRE False.
DEBUG=False

# Obligatoria (SEC-01): sin ella la app lanza ImproperlyConfigured.
SECRET_KEY=cambiar-por-clave-generada

# Dominios permitidos, separados por coma.
ALLOWED_HOSTS=tu-dominio.com,www.tu-dominio.com

# Email del administrador para alertas.
ADMIN_EMAIL=admin@tu-dominio.com

# Poner True solo si sirves por HTTPS detras de proxy.
SECURE_SSL_REDIRECT=False
